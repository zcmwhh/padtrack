# 运行产物
padtrack.log
padtrack.pid
padtrack_*.ps1
key.txt
当前地址.txt

# 本地备份（每次改动前的快照）
backup/

# 打包产物（PadTrack.spec 是构建配置，故意纳入版本管理）
build/
dist/
发布/

# Python
__pycache__/
*.py[cod]
.venv/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
.DS_Store

# 本机工具链的临时目录（含会话记录，不要上传）
.dsh-ops/

# 本机推送辅助脚本（内含远程地址）
推送.bat

# 本机 GUI 自动化调试目录
.probe/

# adb 之类的大体积工具（USB直连.bat 会按需下载）
tools/

# 备用构建目录（构建时发布目录被占用，临时输出到这里）
发布_new/

# 备用/临时构建目录
发布_new*/

# 打包暂存目录（避免占用中的文件导致 zip 失败）
发布_pkg/

# 构建暂存目录
_dist_tmp/
